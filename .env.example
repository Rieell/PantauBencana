# Salin file ini menjadi `.env` (untuk lokal), atau isi di Vercel > Settings > Environment Variables.
# Jangan commit file `.env` yang berisi password asli.

# ---- Database ----
# Lokal (XAMPP):  DB_HOST=localhost, DB_USER=root, DB_PASSWORD= (kosong), DB_SSL=false
# Cloud (Aiven):  isi sesuai halaman Overview service, DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pantaubencana

# Wajib true untuk database cloud. Biarkan false untuk XAMPP lokal.
DB_SSL=false
# Sertifikat CA dari Aiven, ditulis dalam SATU baris dengan baris baru diganti \n
# Contoh: DB_CA="-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----"
DB_CA=

# ---- Keamanan ----
# Wajib di produksi/Vercel. Isi string acak panjang, buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- Opsional ----
# Port API saat jalan lokal (default 5000, harus sama dengan proxy di vite.config.ts)
API_PORT=5000
# Batas baris ekspor CSV (default 50000 lokal, 15000 di Vercel)
# EXPORT_MAX_ROWS=15000
